# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=

# Comma-separated ticker universe for backtests/CLI runs.
TICKER_UNIVERSE=AAPL,MSFT,GOOGL

BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-06-01

INITIAL_CASH=100000

# Directory for cached historical-data parquet files.
DATA_CACHE_DIR=data/cache

# Optional: enables SEC EDGAR filings as point-in-time news evidence. SEC
# requires a User-Agent naming you with a contact email, e.g.
# SEC_USER_AGENT=Jane Doe jane@example.com
# SEC_USER_AGENT=

# Optional per-role model overrides as JSON, e.g. {"researcher": "claude-opus-5"}.
# LLM_ROLE_OVERRIDES=

# Copy to .env and fill in. .env is gitignored.

# LLM provider: "anthropic" (default, needs ANTHROPIC_API_KEY) or "ollama"
# (a local Ollama server; no key needed).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Used only when LLM_PROVIDER=ollama. Pull the model first: ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MAX_CONCURRENCY=2
# OLLAMA_TIMEOUT_SECONDS=300

# Comma-separated ticker universe for backtests/CLI runs.
TICKER_UNIVERSE=AAPL,MSFT,GOOGL

BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-06-01

INITIAL_CASH=100000

# Directory for cached historical-data parquet files.
DATA_CACHE_DIR=data/cache

# Interactive Brokers (needs `pip install -e ".[ib]"` and TWS/IB Gateway with
# the API enabled). Paper TWS: 7497, paper Gateway: 4002. IB_ACCOUNT can stay
# empty if the login manages one account. Check with: trading-agents ib-check
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=1
# IB_ACCOUNT=
# IB_MARKET_DATA=ib            # price bars for the IB live loop: ib | yfinance

# Zerodha Kite Connect (no paper trading - orders are real money and are disabled
# by default). Get the daily access token with: trading-agents kite-login
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=

# Live trading loop (`trading-agents trade`). Dry-run by default. REAL orders need
# both `--mode live` and ALLOW_LIVE_TRADING=true.
# LIVE_BROKER=ib                # ib | kite | execd (the Rust service)
# ALLOW_LIVE_TRADING=false
# LIVE_DECISION_TIME=          # exchange-local HH:MM; default 15:30 (IB) / 15:00 (Kite)
# LIVE_MAX_ORDER_PCT=0.05
# LIVE_MAX_ORDERS_PER_DAY=10
# LIVE_MAX_DAILY_DRAWDOWN_PCT=0.02
# LIVE_KILL_SWITCH_PATH=KILL_SWITCH

# Rust execution service (execution_service/), used when LIVE_BROKER=execd.
# EXECD_TOKEN must match the token execd was started with (>= 16 characters).
# EXECD_HOST=127.0.0.1
# EXECD_PORT=7600
# EXECD_TOKEN=
# EXECD_MARKET=nse              # nse (Kite symbols) | us

# Optional: enables SEC EDGAR filings as point-in-time news evidence. SEC
# requires a User-Agent naming you with a contact email, e.g.
# SEC_USER_AGENT=Jane Doe jane@example.com
# SEC_USER_AGENT=

# Optional per-role model overrides as JSON, e.g. {"researcher": "claude-opus-5"}
# (with Ollama, use Ollama model names, e.g. {"researcher": "qwen3:32b"}).
# LLM_ROLE_OVERRIDES=
